+def run_jobs_collecting_errors(jobs):
+    """Run every job, returning (results, errors) instead of raising."""
+    results, errors = [], []
+    for job in jobs:
+        try:
+            results.append(job())
+        except Exception as exc:  # noqa: BLE001 - reported, not swallowed
+            errors.append((job, exc))
+    return results, errors
