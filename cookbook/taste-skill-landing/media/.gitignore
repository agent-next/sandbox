# Recorded browser footage for the Remotion composition. Regenerated by
# media/record_clips.py on every make_media.sh run; the composition reads
# them from media/video/../clips, so they must exist on disk but are never
# committed (they are ~13 MB of raw screen recordings).
clips/

# Remotion's own build output and the render target (gitignored for the same
# reason — a rendered master is not source).
video/out/
video/node_modules/
video/.remotion/

# The lossless ffmpeg intermediate the demo video is encoded from.
master/

# Judge run artefacts regenerated by make_media.sh.
verdict-good.json
verdict-baseline.json
selftest-kills.txt
facts.json
