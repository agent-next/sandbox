# Media build artifacts (cookbook/DEMO-STANDARD.md): every committed file
# in media/ is regenerated by make_media.sh from the real judge outputs.
# The lossless master/ is required by the standard to be git-ignored; the
# frame PNGs and build scratch are intermediates with no committed value.

master/          # lossless crf 0 master, input to the web encode
frames/          # rendered per-slot PNG frames
work/            # make_media.sh build scratch (judge logs, mutant dirs)

__pycache__/
*.pyc