{
  "_comment": [
    "Known-answer mask for the firmware-qemu demo. Every expected response",
    "here is derived from SPEC.md, not from the artifact under test. The",
    "judge compares the firmware's UART output against these exact strings."
  ],
  "banner": "firmware-qemu 1.0 cortex-m3 lm3s6965evb ready",
  "prompt": "",
