      "expect": "OK 3"
    },
    {
      "line": "RB dump",
      "expect": "OK 01 02 03"
    },
    {
      "line": "RB pop",
      "expect": "OK 2"
    },
    {
      "line": "RB dump",
      "expect": "OK 02 03"
    },
    {
      "line": "RB pop",
      "expect": "OK 1"
    },
    {
