    },
    {
      "line": "CRC abc",
      "expect": "ERR bad hex"
    },
    {
      "line": "CRC zz",
      "expect": "ERR bad hex"
    },
    {
      "line": "CRC 0z",
      "expect": "ERR bad hex"
    },
    {
      "line": "RB count",
      "expect": "OK 0"
