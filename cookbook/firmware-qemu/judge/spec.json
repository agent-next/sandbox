    {
      "line": "HELP",
      "expect": "OK commands: HELP VER ID CRC RB PING ECHO"
    },
    {
      "line": "VER",
      "expect": "OK firmware-qemu 1.0 cortex-m3"
    },
    {
      "line": "ID",
      "expect": "OK lm3s6965evb"
    },
    {
      "line": "PING",
      "expect": "OK pong"
    },
    {
      "line": "ECHO hello world",
      "expect": "OK hello world"
    },
    {
      "line": "ECHO   spaced   out  ",
      "expect": "OK spaced   out  "
    },
    {
      "line": "ECHO",
      "expect": "ERR unknown"
    },
    {
      "line": "BOGUS",
      "expect": "ERR unknown"
    },
    {
      "line": "rbfrob",
      "expect": "ERR unknown"
    },
    {
      "line": "RB nonsense",
      "expect": "ERR unknown"
    },
    {
      "line": "RB",
      "expect": "ERR unknown"
    },
    {
      "line": "CRC 31323334",
      "expect": "OK 0x9be3e0a3"
    },
    {
      "line": "CRC 313233343536373839",
      "expect": "OK 0xcbf43926"
    },
    {
      "line": "CRC deadbeef",
