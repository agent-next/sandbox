__pycache__/
*.pyc
media/.venv/
media/frames/
media/master/
media/clips/
media/video/node_modules/
media/video/renders/
# no trailing slash: .toolchain is a symlink to the local toolchain, and
# git will not match a directory-only pattern against one
examples/good/.toolchain

# clips are derived: media/make_media.sh writes them into media/clips/
# video/clips is a symlink to it, so the composition can mount clips/ in place
/video/clips

# pyte/Pillow for the terminal player: installed by media/collect-media-deps.sh,
# never committed
media/.pylib/
