# Media generation for cfd-openfoam

# make_media.sh regenerates everything in this directory except what it
# writes to judge_runs/ itself (which is also disposable: judge output,
# regenerated by grade.sh --trace and grade.sh on the examples).

# raw judge outputs (verdict JSONs, solver traces) — regenerated by
# media/make_media.sh via judge/grade.sh, never committed
judge_runs/

# lossless video master (crf 0), input to the web encode — gitignored per
# DEMO-STANDARD.md; only demo.mp4 is committed
master/

# 30 fps motion clips rendered from the judge's --trace output by
# media/video/render_clips.py — inputs to the Remotion composition
clips/

# Remotion project scratch: installed deps, bundles and frame output
video/node_modules/
video/out/
video/build/
video/.remotion/

__pycache__/
*.pyc
