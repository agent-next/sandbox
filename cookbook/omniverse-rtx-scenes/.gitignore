# Raw downloaded NVIDIA SimReady / Isaac assets: large, license-attributed in
# assets.lock.json, fetched by scenes/build_scenes.py. Never committed.
assets/
scenes/*/assets/
# MDL base chain copies regenerated by build_scenes.py into each scene.
scenes/*/mdl/
scenes/out/
__pycache__/
*.pyc

# local scratch (probe scripts, bundles, downloads) — never committed
scratch/
out/

# media build work dirs and the lossless master (regenerated by make_media.sh)
media/work/
media/master/
# media built from a stub run dir — regenerate from a real run with
# media/make_media.sh before shipping
media/result.png
media/loop.png
media/demo.mp4
media/MANIFEST.json
